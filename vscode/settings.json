{
  "[html]": {
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
  },
  "[json]": {
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "strings": "on",
    },
    "editor.suggest.insertMode": "replace",
  },
  "[markdown]": {
    // https://code.visualstudio.com/docs/editor/intellisense , https://stackoverflow.com/a/41324717/2958070
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.quickSuggestions": {
      "comments": "on",
      "other": "on",
      "strings": "on",
    },
    "editor.suggest.insertMode": "replace",
    "editor.suggest.localityBonus": true,
    "editor.suggestSelection": "recentlyUsed",
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
  },
  "accessibility.signalOptions.volume": 100,
  "accessibility.signals.chatResponseReceived": {
    "sound": "on",
  },
  "accessibility.signals.chatUserActionRequired": {
    "sound": "on",
  },
  "chat.defaultConfiguration": {
    "approvals": "assisted",
  },
  "chat.notifyWindowOnConfirmation": "always",
  "chat.notifyWindowOnResponseReceived": "always",
  // Explicitly "default" (Default Permissions): local chat asks before running tools/commands
  // unless they're in chat.tools.*.autoApprove below. "autoApprove" (Bypass Approvals) ignores
  // those lists and never asks. "assisted" isn't valid here - only in chat.defaultConfiguration.
  "chat.permissions.default": "default",
  "chat.tools.terminal.autoApprove": {
    "cargo check": true,
    "cargo clippy": true,
    "cargo fmt": true,
    "cargo insta": true,
    "cargo run": true,
    "cargo test": true,
    "d2": true,
    "go": true,
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://docs.rs": true,
    "https://docs.sqlc.dev": true,
    "https://docs.syntaqlite.com": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true,
    },
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://sw.kovidgoyal.net": true,
  },
  "chat.viewSessions.orientation": "stacked",
  "dart.previewFlutterUiGuides": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "comments": "on",
    "other": "on",
    "strings": "on",
  },
  "editor.renderWhitespace": "all",
  "editor.tokenColorCustomizations": {
    "[Miramare]": {
      "comments": "#c0c0c0",
    },
  },
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.wordWrap": "on",
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "git.confirmSync": false,
  "git.detectWorktrees": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.enable": {
    "*": false,
    "go": true,
    "python": true,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.preferredAccount": "bkane-msft",
  "gitlens.graph.layout": "editor",
  "go.formatTool": "goimports",
  "go.inlayHints.constantValues": true,
  "go.lintOnSave": "workspace",
  "go.lintTool": "golangci-lint-v2",
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "gopls": {
    "ui.navigation.symbolScope": "workspace",
  },
  "indentRainbow.colors": [
    "#e2987013",
    "#89beba13",
    "#87af8713",
    "#c0c0c013",
  ],
  "indentRainbow.excludedLanguages": [
    "go",
    "json",
    "jsonc",
    "plaintext",
  ],
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
  "outline.showVariables": false,
  "problems.defaultViewMode": "table",
  "python.analysis.inlayHints.functionReturnTypes": false,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.languageServer": "Pylance",
  "redhat.telemetry.enabled": true,
  "ruff.lineLength": 100,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.genericParameterHints.const.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "security.workspace.trust.untrustedFiles": "open",
  "swaggerViewer.previewInBrowser": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.fontSize": 15,
  "update.mode": "start",
  "vscode-default-keybindings.macOSKeybindings": true,
  "window.autoDetectColorScheme": true,
  "window.zoomLevel": 1,
  "workbench.colorCustomizations": {
    "[Miramare]": {
      "activityBar.border": "#e6dcac3f",
      "activityBar.foreground": "#87af87",
      "activityBar.inactiveForeground": "#e6dcac",
      "editor.findMatchHighlightBackground": "#87af877f",
      "editor.findRangeHighlightBackground._comment": "https://code.visualstudio.com/api/references/theme-color#editor-colors",
      "editorGroup.border": "#e6dcac3f",
      "editorLineNumber.foreground": "#c0c0c09f",
      "panel.border": "#e6dcac3f",
      "panelTitle.activeForeground": "#87af87",
      "panelTitle.inactiveForeground": "#e6dcac",
      "scrollbarSlider.background": "#928374",
      "sideBar.border": "#e6dcac3f",
      "sideBarSectionHeader.border": "#e6dcac3f",
      "tab.activeBorderTop": "#e6dcac3f",
    },
  },
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.externalBrowser": "firefox",
  "workbench.preferredDarkColorTheme": "Dark 2026",
  "workbench.preferredLightColorTheme": "Light 2026",
  "workbench.sideBar.location": "right",
  "yaml.format.singleQuote": true,
}
